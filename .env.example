# Copy to .env.local (gitignored) and fill in.

# Server-side key for the realtime video provider. Never exposed to the browser;
# the /api/fal/proxy route attaches it on the server.
FAL_KEY=c0e16286-4d60-446f-805c-5988baa96354:ccfdde1a132513e85b99fc37627a0371

# Passcode that unlocks /demo and the proxy route. Leave unset to keep the demo
# open (local development only).
DEMO_PASSCODE=5524
